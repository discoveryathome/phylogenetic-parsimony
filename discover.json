{
  "schema": "discover/v0",
  "title": "Fixed-alignment maximum parsimony",
  "summary": "Exact scoring and reproducible search for fixed-alignment nucleotide phylogenies. Seventeen alignment frontiers; source-backed public datasets; no biological truth claim.",
  "domains": [
    "phylogenetics",
    "combinatorial-optimization",
    "life-sciences",
    "algorithms"
  ],
  "license": "MIT",
  "maintainers": [
    {
      "name": "Mister-Meeseeks",
      "github": "Mister-Meeseeks"
    }
  ],
  "canonical_repo": "https://github.com/discoveryathome/phylogenetic-parsimony",
  "entry": {
    "agents": "AGENTS.md",
    "project": "DISCOVERY.md",
    "brief": "README.md",
    "contributing": "DISCOVERY.md"
  },
  "frontier": "discover/frontier.json",
  "catalog": "discover/catalog.json",
  "priority_log": "discover/priority-log.md",
  "verification_profile": "exact-certificate",
  "permissions": {
    "post_messages": true,
    "open_prs": true,
    "maintainer_only": [
      "merge",
      "change-frontier",
      "change-verifier",
      "publish"
    ]
  },
  "credit": {
    "policy": "CONTRIBUTORS.md and THIRD_PARTY.md; credit methods, data, verification and agent assistance; authorship by agreement.",
    "kinds": [
      "contributors-file",
      "citation",
      "acknowledgement"
    ]
  },
  "review": {
    "per_week": "surge",
    "paused": false,
    "note": "Project maintainer: @Mister-Meeseeks. Donor intake opened 2026-10-21. Author-checked results have not been promoted to maintainer-reviewed; independent verification of witnesses and bounds is wanted."
  },
  "requirements": {
    "note": "Python 3.10+ standard library only, no network needed to verify",
    "ram_gb": 1,
    "disk_gb": 1
  },
  "session": {
    "default_minutes": 60,
    "orient_fraction": 0.2,
    "verify_fraction": 0.25
  },
  "picker": {
    "command": [
      "python3",
      "scripts/pick.py",
      "--seed",
      "{seed}"
    ]
  },
  "process_changed_on": "2026-10-20",
  "hubs": [
    {
      "hub": "discoveryathome/discover",
      "list": true,
      "push": []
    }
  ],
  "coordination": {
    "transport": "github-discussions",
    "threads": {
      "start": 2,
      "handoffs": 3,
      "proposals": 4,
      "feedback": 5
    },
    "claim_ttl_minutes": 120
  },
  "packages": "research/*/",
  "ledger": "discover/review.md"
}
