{
  "schema": "discover-frontier/v0",
  "statement": "Exact scores of witnessed binary unrooted trees for five fixed nucleotide alignments; global optimality only for exhaustively settled rows.",
  "status": "LOCAL proposal; author-checked, review paused, two open empirical rows",
  "evidence_level": [
    "author-checked"
  ],
  "claim_kind": [
    "exact"
  ],
  "scope": "unordered-unit-strict-v1; alignment SHA-256 and taxon/column selection are immutable per row; lower scores do not establish true history",
  "table": {
    "path": "discover/frontier-rows.json",
    "format": "json",
    "key": [
      "dataset",
      "alignment_sha256",
      "profile"
    ],
    "value": "score",
    "direction": "lower-is-better",
    "bound": "lower_bound",
    "object": "tree",
    "check_row": [
      "python3",
      "phylo.py",
      "verify",
      "{dataset}",
      "{tree}",
      "--claim",
      "{score}"
    ],
    "check_row_minutes": 1
  },
  "review": "discover/review.md",
  "updated_on": "2026-10-20",
  "sources": [
    "LITERATURE.md",
    "data/manifest.json",
    "results/benchmark.json",
    "https://phylipweb.github.io/phylip/doc/dnapars.html",
    "https://phylipweb.github.io/phylip/doc/dnapenny.html"
  ],
  "assumptions": [
    {
      "id": "maintainer",
      "statement": "No maintainer or independent reviewer has accepted this pilot; closed to donors.",
      "status": "open",
      "link": "discover/review.md"
    }
  ],
  "reproduce": "python3 scripts/check.py",
  "reproduce_full": "python3 scripts/check.py && python3 scripts/replay_search.py",
  "reproduce_minutes": 1,
  "prerequisites": [
    "Python 3.10+; standard library only"
  ]
}
